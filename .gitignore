benchmark/benchmark_results*/

benchmark/public

# Local environment config
.env

# Linter / tooling caches
.ruff_cache/

# AFL / fuzzer transient artifacts
# NOTE: 早期 sqlite fuzzer 曾以仓库根/benchmark 为 CWD 运行，向工作树写入
# 上万个随机命名的 SQL 片段垃圾文件。根因修复是让 fuzzer 在临时目录中运行
# （run_benchmark.py 现已使用 tempdir 工作目录）；以下仅覆盖可命名的临时文件。
.afl-showmap-temp-*
.state/
*.cur_input
