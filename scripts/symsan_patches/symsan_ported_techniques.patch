+int symsan_set_focus_bytes(const char *spec) {
+  // 选择性符号化区间规格:【单个】区间 "起-止"(如 "0-3");NULL/空串=符号化全部字节。
+  //
+  // 只支持单区间不是偷懒,是被下游解析器逼的:该串最终被拼进 TAINT_OPTIONS 交给 DFSan 的
+  // sanitizer flag 解析器,而它的 is_space()(sanitizer_flag_parser.cpp)把 ',' 和 ':'
+  // 都算作分隔符。于是 "0-3,8-11" 会在 ',' 处被截断,残留的 "8-11" 被当成一个【未知 flag】,
+  // 触发 Die() —— 目标直接死掉,一条输出都产不出。语义上也与 SymCC 的
+  // sscanf("%lu-%lu") 单区间一致。故这里【严格校验】:只放行 ^[0-9]+-[0-9]+$,
+  // 任何含分隔符/多余字符的规格一律拒绝(返回 SYMSAN_INVALID_ARGS),
+  // 宁可退回全字节符号化(慢但正确),也不要把目标送进 Die()。
+  if (spec == NULL || spec[0] == '\0') {
+    free(g_config.focus_bytes);
+    g_config.focus_bytes = NULL;
+    return 0;
+  }
+
+  const char *p = spec;
+  size_t digits_lo = 0, digits_hi = 0;
+  while (*p >= '0' && *p <= '9') { p++; digits_lo++; }
+  if (digits_lo == 0 || *p != '-') return SYMSAN_INVALID_ARGS;
+  p++;
+  while (*p >= '0' && *p <= '9') { p++; digits_hi++; }
+  if (digits_hi == 0 || *p != '\0') return SYMSAN_INVALID_ARGS;
+
+  free(g_config.focus_bytes);
+  g_config.focus_bytes = strdup(spec);
+  if (g_config.focus_bytes == NULL) return SYMSAN_NO_MEMORY;
+  return 0;
+}
