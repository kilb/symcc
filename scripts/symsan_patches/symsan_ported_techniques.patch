index 4249f22..5019ded 100644
--- a/include/launch.h
+++ b/include/launch.h
@@ -45,6 +45,13 @@ int symsan_set_trace_file_size(int enable);
 /// @brief set the force stdin mode for the target binary
 int symsan_set_force_stdin(int enable);
 
+/// @brief 选择性符号化:仅污染指定输入偏移区间。移植自 SymCC 的 SYMCC_FOCUS_BYTES。
+/// @param spec 【单个】区间 "起-止"(如 "0-3");NULL/空串=符号化全部字节(默认)。
+///        不支持逗号分隔的多区间:该串要经 TAINT_OPTIONS 交给 DFSan 的 flag 解析器,
+///        而它把 ',' 与 ':' 当分隔符,多区间会被截断并触发 Die()。
+/// @return 0 成功;SYMSAN_INVALID_ARGS 规格不是 ^[0-9]+-[0-9]+$(此时保持原有设置不变)。
+int symsan_set_focus_bytes(const char *spec);
+
