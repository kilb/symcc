diff --git a/driver/symcc_techniques.h b/driver/symcc_techniques.h
new file mode 100644
index 0000000..9c4a133
--- /dev/null
+++ b/driver/symcc_techniques.h
@@ -0,0 +1,153 @@
+// 移植自 SymCC 的自研技术,fgtest.cpp(进程内 Z3)与 fgtest_rgd.cpp(RGD/JIGSAW)共用。
+//
+// 抽出成公共头是为了消除两份逐字拷贝——此前两个 driver 各自维护一份
+// load_dictionary/emit_hints/save_dict_variants,任一处修 bug 都要记得同步改另一处
+// (实际已经漂移过)。两 driver 唯一的差异是"怎么把一段字节写成输出文件",故用一个
+// writer 回调注入,其余逻辑完全共享。
+//
+// 覆盖的技术点:
+//   ② SYMCC_EMIT_HINTS —— 给每个求解输出写 "<path>.hints" 旁车,每行 offset:old:new
+//      (十六进制),编排层(mpi_fuzzing_helper 读 *.hints → hint_map)据此做精准变异;
+//   ③ SYMCC_DICT       —— 载入 AFL 字典,对求解改动的首个位置拼 token 产额外变体。
+//
+// 开关一律经与 SymCC 同名的环境变量下发(SymSanEngine.wrap_run 原样透传给 driver)。
+#ifndef SYMCC_TECHNIQUES_H
+#define SYMCC_TECHNIQUES_H
+
+#include <fstream>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace symcc_tech {
+
+// 布尔环境开关:变量【存在且值不是关】才算开。
+//
+// 曾经写成 `getenv(x) != nullptr`,于是 SYMCC_EMIT_HINTS=0 反而把功能【打开】——消融实验
+// 里把开关显式置 0 是最自然的写法,却得到与置 1 相同的结果。此处按值判定,"0/false/no/off/
+// 空串"都算关(大小写不敏感),其余算开;变量不存在时返回 def。
+inline bool env_enabled(const char *name, bool def = false) {
+  const char *v = getenv(name);
+  if (v == nullptr) return def;
+  if (v[0] == '\0') return false;
+  if (!strcasecmp(v, "0") || !strcasecmp(v, "false") ||
+      !strcasecmp(v, "no") || !strcasecmp(v, "off"))
+    return false;
+  return true;
+}
+
+class Techniques {
+ public:
+  // 把一段字节写成一个编号输出文件,返回路径(空串=失败)。由各 driver 注入。
+  using writer_t = std::function<std::string(const uint8_t *, size_t, const char *)>;
+
+  // seed/seed_size 为原始种子(driver 侧 mmap 的输入),生命周期须覆盖本对象。
+  void init(const uint8_t *seed, size_t seed_size, writer_t writer) {
+    seed_ = seed;
+    seed_size_ = seed_size;
+    write_ = std::move(writer);
+    emit_hints_ = env_enabled("SYMCC_EMIT_HINTS");
+    load_dictionary();
+  }
+
+  bool hints_enabled() const { return emit_hints_; }
+  size_t dict_size() const { return dict_.size(); }
+
+  // ② 写 offset:old:new 旁车。
+  //
+  // 只在 len == seed_size_ 时写:hint 是【按位置】比对求解结果与种子得出的,而 INSERT/
+  // DELETE 类解(Z3 的 solution_op_t::INSERT/DELETE、I2S 把整数改写成不同长度的十进制串)
+  // 会移动插入点之后的全部字节,逐位置比对会把一整段未改动的尾部误报成"改动",给编排层
+  // 一堆错误偏移——比没有 hint 更糟。长度变了就干脆不写。
+  void emit_hints(const std::string &path, const uint8_t *out, size_t len) const {
+    if (!emit_hints_ || path.empty() || out == nullptr) return;
+    if (len != seed_size_) return;  // 长度变化 → 位置对齐失效,见上
+    std::ofstream hf(path + ".hints");
+    if (!hf.is_open()) return;
+    char buf[64];
+    for (size_t i = 0; i < len; i++) {
+      if (out[i] != seed_[i]) {
+        snprintf(buf, sizeof(buf), "%zu:%02x:%02x\n", i, seed_[i], out[i]);
+        hf << buf;
+      }
+    }
+  }
+
+  // ③ 对求解改动的【首个】位置拼字典 token 产变体(cap 20),从种子出发。
+  //    跳过与原值/解相同的 token(不产生重复输入)。复刻 SymCC saveDictVariants。
+  //    首个差异位置在长度变化时依然有效(其前缀逐字节相同),故不受 emit_hints 的限制。
+  void save_dict_variants(const uint8_t *solved, size_t len) const {
+    if (dict_.empty() || solved == nullptr) return;
+    size_t first = SIZE_MAX;
+    for (size_t i = 0; i < len && i < seed_size_; i++)
+      if (solved[i] != seed_[i]) { first = i; break; }
+    if (first == SIZE_MAX) return;
+    int variants = 0;
+    const int kMaxDictVariants = 20;
+    for (const auto &token : dict_) {
+      if (variants >= kMaxDictVariants) break;
+      if (first + token.size() > seed_size_) continue;
+      bool same_orig = true, same_solved = true;
+      for (size_t j = 0; j < token.size(); j++) {
+        if (token[j] != seed_[first + j]) same_orig = false;
+        if (first + j < len && token[j] != solved[first + j]) same_solved = false;
+      }
+      if (same_orig || same_solved) continue;
+      std::vector<uint8_t> variant(seed_, seed_ + seed_size_);
+      for (size_t j = 0; j < token.size(); j++) variant[first + j] = token[j];
+      write_(variant.data(), variant.size(), "dict");
+      variants++;
+    }
+  }
+
+  // 一个求出的新输入的完整出口:hint 旁车 + 字典变体。
+  void on_solution(const std::string &path, const uint8_t *out, size_t len) const {
+    emit_hints(path, out, len);
+    save_dict_variants(out, len);
+  }
+
+ private:
+  // ③ 载入 AFL 字典(SYMCC_DICT):格式 "token" 或 name="token",支持 \xNN 转义。
+  void load_dictionary() {
+    const char *dict_path = getenv("SYMCC_DICT");
+    if (!dict_path) return;
+    std::ifstream ifs(dict_path);
+    if (ifs.fail()) return;
+    std::string line;
+    while (std::getline(ifs, line)) {
+      // 跳过 AFL 字典的注释行(以 # 开头,允许前导空白)。此前没跳,于是形如
+      // # "http://" 的注释被当成真 token 载入,污染变体。
+      size_t ns = line.find_first_not_of(" \t\r");
+      if (ns == std::string::npos || line[ns] == '#') continue;
+      size_t s = line.find('"'), e = line.rfind('"');
+      if (s == std::string::npos || e == std::string::npos || s >= e) continue;
+      std::string t = line.substr(s + 1, e - s - 1);
+      std::vector<uint8_t> token;
+      for (size_t i = 0; i < t.size(); i++) {
+        if (t[i] == '\\' && i + 3 < t.size() && t[i + 1] == 'x') {
+          char hex[3] = {t[i + 2], t[i + 3], '\0'};
+          token.push_back((uint8_t)strtol(hex, NULL, 16));
+          i += 3;
+        } else {
+          token.push_back((uint8_t)t[i]);
+        }
+      }
+      if (!token.empty()) dict_.push_back(token);
+    }
+  }
+
+  bool emit_hints_ = false;
+  std::vector<std::vector<uint8_t>> dict_;
+  const uint8_t *seed_ = nullptr;
+  size_t seed_size_ = 0;
+  writer_t write_;
+};
+
+}  // namespace symcc_tech
+
+#endif  // SYMCC_TECHNIQUES_H
