   // if fd is a tainted file, the label should have been pre-allocated
-  else return (offset + CONST_OFFSET);
+  else {
+    if (!focus_active(offset)) return 0;  // 选择性符号化:非 focus 字节保持具体
+    return (offset + CONST_OFFSET);
