 /// @param fd: input file descriptor, only used if input is "stdin"
 /// @return < 0 on syscall error, > 0 on setup error, 0 on success
diff --git a/libcxx/CMakeLists.txt b/libcxx/CMakeLists.txt
index 361d2a5..f7feab2 100644
--- a/libcxx/CMakeLists.txt
+++ b/libcxx/CMakeLists.txt
@@ -1,8 +1,23 @@
 # run rebuild.sh
-
-install (FILES "build_taint/lib/libc++.a" DESTINATION "${SYMSAN_LIB_DIR}")
-install (FILES "build_taint/lib/libc++abi.a" DESTINATION "${SYMSAN_LIB_DIR}")
-install (FILES "build_taint/lib/libunwind.a" DESTINATION "${SYMSAN_LIB_DIR}")
+#
+# 这三个是【污点插桩版】libc++/libc++abi/libunwind,只有先跑 libcxx/rebuild.sh 才会存在。
+# 原本是无条件 install(...),于是【没跑过 rebuild.sh 时 `make install` 必然失败】:
+#   CMake Error: file INSTALL cannot find ".../libcxx/build_taint/lib/libc++.a"
+# 失败发生在安装的最后阶段,ko-clang / fgtest / fgtest_rgd 其实都已经编好并装进 install/bin,
+# 但整条 `make install` 返回非零 → 自动化构建judge为失败、install/ 停在半成品状态。
