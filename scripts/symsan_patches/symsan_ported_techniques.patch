+static void emit_hints(const std::string& path, const std::vector<uint8_t>& out) {
+  if (!__emit_hints || path.empty()) return;
+  std::ofstream hf(path + ".hints");
+  if (!hf.is_open()) return;
+  char buf[64];
+  for (size_t i = 0; i < out.size() && i < input_size; i++) {
